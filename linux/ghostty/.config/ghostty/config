# The syntax is "key = value". The whitespace around the equals doesn't matter.
# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

keybind = super+z=close_surface
keybind = super+d=new_split:right

# Empty values reset the configuration to the default value

font-family = "Monaspace Xenon NF"
font-family-bold = "Monaspace Xenon NF"
font-family-italic = "Monaspace Xenon NF"
font-family-bold-italic = "Monaspace Xenon NF"

# Monaspace ligatures are opt-in; calt = texture healing
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

window-decoration = false
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
resize-overlay = never

theme = Catppuccin Frappe
# theme = Catppuccin Latte
# theme = Monokai Pro Machine

window-padding-x = 4
window-padding-y = 4

keybind = shift+enter=text:\x1b\r
