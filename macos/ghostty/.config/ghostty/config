# The syntax is "key = value". The whitespace around the equals doesn't matter.
# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

keybind = super+z=close_surface
keybind = super+d=new_split:right

# Empty values reset the configuration to the default value

# The first font-family is the primary; repeated entries are fallbacks.
# JetBrainsMono Nerd Font stays in the list so Nerd Font glyphs still
# resolve (Monaspace has no icon glyphs).
font-family = "Monaspace Neon"
font-family = "JetBrainsMono Nerd Font"
font-family-bold = "Monaspace Neon"
font-family-bold = "JetBrainsMono Nerd Font"
font-family-italic = "Monaspace Radon"
font-family-italic = "JetBrainsMono Nerd Font"
font-family-bold-italic = "Monaspace Radon"
font-family-bold-italic = "JetBrainsMono Nerd Font"

# Monaspace texture healing + code ligatures
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

window-decoration = false
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
resize-overlay = never

theme = forestbones
# theme = Catppuccin Frappe
# theme = Catppuccin Latte

window-padding-x = 4
window-padding-y = 4

keybind = shift+enter=text:\x1b\r
keybind = alt+backspace=text:\x1b\x7f

